POSTGRES_PASSWORD=change-me
BASE_CURRENCY=USD
# Enabled regions, first is the default. v1 = US only. Others: GB,DE,FR,CA,AU,BR,PL
REGIONS=US
# Required to use /api/admin/*. Leave empty to disable admin endpoints.
ADMIN_TOKEN=
# Hour (UTC) the daily job runs. GOGDB publishes its dump ~00:02 UTC.
SCHEDULE_HOUR_UTC=6
